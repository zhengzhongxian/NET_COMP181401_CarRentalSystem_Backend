    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "OVERRIDE_IN_ENV_OR_SECRETS",
          "indexFormat": "renticar-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv7",
          "numberOfShards": 1,
          "numberOfReplicas": 0,
          "ilmLifecycleName": "renticar-logs-30d-policy",
          "ilmRolloverAlias": "renticar-logs"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ElasticsearchIlm": {
    "PolicyName": "renticar-logs-30d-policy",
    "HotMaxAge": "1d",
    "DeleteAfterDays": "30d"
